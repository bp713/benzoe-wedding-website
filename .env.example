# Google Apps Script endpoint that receives newsletter subscriptions
GOOGLE_SHEETS_ENDPOINT=https://script.google.com/macros/s/your-deployment-id/exec

# Protected Google Apps Script endpoint for RSVP submissions
GOOGLE_RSVP_ENDPOINT=https://script.google.com/macros/s/your-rsvp-deployment-id/exec
GOOGLE_RSVP_TOKEN=replace-with-a-long-random-secret
